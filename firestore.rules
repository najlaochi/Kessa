rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /subjects/{id} { allow read: if true; allow write: if isAdmin(); }
    match /stories/{id}  { allow read: if true; allow write: if isAdmin(); }
    // Parents' emails for "new stories" news: anyone can add one, only admins can read
    match /waitlist/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'language', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                    && request.resource.data.language in ['ar', 'en']
                    && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }
    // narrationUsage is only used by the server (daily limits); no app access
    match /narrationUsage/{id} { allow read, write: if false; }
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // Nobody can make themselves admin. Set isAdmin = true manually in the Firebase console.
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.isAdmin == false;
      allow update, delete: if isAdmin();
    }
  }
}
