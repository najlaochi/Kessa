rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /{folder}/{allPaths=**} {
      // narration/ holds MP3s made by the generateNarration function (written by the server only)
      allow read: if folder in ['subjects', 'stories', 'music', 'narration', 'story-audio'];
      allow write: if folder in ['subjects', 'stories', 'music'] && isAdmin()
                   && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
